{
  "description": "JSON mẫu để test Login và Register (Postman / curl / REST client). Chạy migration trước: backend/migrations/001_add_password_to_users.sql",
  "base_url": "http://localhost:5000",
  "register": {
    "url": "POST {{base_url}}/auth/register",
    "headers": {
      "Content-Type": "application/json"
    },
    "body_minimal": {
      "phone": "0901234567",
      "password": "password123"
    },
    "body_full": {
      "phone": "0901234567",
      "password": "password123",
      "full_name": "Nguyễn Văn A",
      "device_token": "fcm-or-apns-token-optional",
      "lat": 21.0285,
      "lng": 105.8542,
      "district_id": 1
    }
  },
  "login": {
    "url": "POST {{base_url}}/auth/login",
    "headers": {
      "Content-Type": "application/json"
    },
    "body": {
      "phone": "0901234567",
      "password": "password123"
    },
    "body_with_device_token": {
      "phone": "0901234567",
      "password": "password123",
      "device_token": "fcm-token-update"
    }
  },
  "me": {
    "url": "GET {{base_url}}/auth/me",
    "headers": {
      "Authorization": "Bearer <token_trả_về_từ_login_hoặc_register>"
    }
  },
  "example_responses": {
    "register_success_201": {
      "message": "Đăng ký thành công",
      "user": {
        "id": 1,
        "phone": "0901234567",
        "full_name": "Nguyễn Văn A"
      }
    },
    "login_success_200": {
      "message": "Đăng nhập thành công",
      "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...",
      "user": {
        "id": 1,
        "phone": "0901234567",
        "full_name": "Nguyễn Văn A"
      }
    },
    "me_success_200": {
      "user": {
        "id": 1,
        "phone": "0901234567",
        "full_name": "Nguyễn Văn A",
        "device_token": null,
        "district_id": 1,
        "status": "ACTIVE",
        "created_at": "2025-02-01T10:00:00"
      }
    },
    "error_400": {
      "error": "Thiếu số điện thoại"
    },
    "error_401": {
      "error": "Số điện thoại hoặc mật khẩu không đúng"
    },
    "error_403": {
      "error": "Số điện thoại đã bị chặn"
    },
    "error_409": {
      "error": "Số điện thoại đã được đăng ký"
    }
  }
}
